@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var habitaciones = controller == "Habitaciones";
    var disponibilidad = controller == "Reservas" && action == "Disponibles";
    var reservas = controller == "Reservas" && !disponibilidad;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#173e38" />
    <title>@ViewData["Title"] · Hotel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a href="#contenido" class="skip-link">Ir al contenido</a>
    <svg class="icon-library" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs>
        <symbol id="i-bed" viewBox="0 0 24 24"><path d="M3 18v3m18-3v3M3 14h18v4H3zm2 0V6a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v8M5 10h14M9 10v4m6-4v4" /></symbol>
        <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 11h18m-13 5 3 3 5-5"/></symbol>
        <symbol id="i-book" viewBox="0 0 24 24"><rect x="5" y="3" width="15" height="18" rx="2"/><path d="M3 7h4m-4 5h4m-4 5h4m4-9h5m-5 4h5m-5 4h3"/></symbol>
        <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
        <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-5-5 5 5-5 5"/></symbol>
        <symbol id="i-back" viewBox="0 0 24 24"><path d="M19 12H5m5-5-5 5 5 5"/></symbol>
        <symbol id="i-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></symbol>
        <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
        <symbol id="i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v6m0-10v.01"/></symbol>
    </defs></svg>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-controller="Habitaciones" asp-action="Index"><span class="brand-mark">H<span>·</span></span><span>Hotel<small>ADMINISTRACIÓN</small></span></a>
            <div class="nav-caption">ESPACIO DE TRABAJO</div>
            <nav class="side-nav" aria-label="Navegación principal">
                <a class="@(habitaciones ? "active" : "")" aria-current="@(habitaciones ? "page" : null)" asp-controller="Habitaciones" asp-action="Index"><svg class="icon"><use href="#i-bed"/></svg>Habitaciones<span class="nav-indicator"></span></a>
                <a class="@(disponibilidad ? "active" : "")" aria-current="@(disponibilidad ? "page" : null)" asp-controller="Reservas" asp-action="Disponibles"><svg class="icon"><use href="#i-calendar"/></svg>Disponibilidad<span class="nav-indicator"></span></a>
                <a class="@(reservas ? "active" : "")" aria-current="@(reservas ? "page" : null)" asp-controller="Reservas" asp-action="Index"><svg class="icon"><use href="#i-book"/></svg>Reservas<span class="nav-indicator"></span></a>
            </nav>
            <div class="sidebar-note"><span class="eyebrow">CADA ESTADÍA CUENTA</span><p>Todo listo para recibir<br />a tus próximos huéspedes.</p><svg class="hospitality-art" viewBox="0 0 160 78" fill="none" aria-hidden="true"><path d="M6 69h148M28 69V22h42v47m0-36h61v36M23 22 49 6l26 16M40 34h17v12H40zm0 35V55h17v14m25-25h12v11H82zm25 0h12v11h-12z" stroke="currentColor" stroke-width="1.2"/><path d="M138 69V42m0 14c-15-4-15-18 0-22 15 4 15 18 0 22Z" stroke="currentColor" stroke-width="1.2"/></svg></div>
            <div class="sidebar-footer"><span class="status-dot"></span>Panel de administración<small>Hotel.Web · 2026</small></div>
        </aside>
        <div class="workspace">
            <header class="topbar"><div><span class="topbar-label">Gestión del hotel</span><span class="breadcrumb-divider">/</span><span>@(habitaciones ? "Habitaciones" : disponibilidad ? "Disponibilidad" : "Reservas")</span></div><span class="workspace-badge"><span class="avatar">H</span>Recepción</span></header>
            <main id="contenido" class="main-content">
                @if (TempData["Mensaje"] is string mensaje) {
                    <div class="notice" role="status"><svg class="icon"><use href="#i-check"/></svg>@mensaje</div>
                }
                @RenderBody()
            </main>
            <footer class="workspace-footer"><span>Hotel · Gestión de habitaciones y reservas</span><span>Atención en cada detalle.</span></footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
